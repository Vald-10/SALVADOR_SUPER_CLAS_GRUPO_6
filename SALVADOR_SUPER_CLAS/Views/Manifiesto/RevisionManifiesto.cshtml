@model SALVADOR_SUPER_CLAS.ViewModels.ManifiestoViewModel

@{
    ViewData["Title"] = "Manifiesto de Aduana";
}

<div class="ssc-card">
    <div class="ssc-card-header">
        <span><i class="bi bi-file-earmark-text"></i> Manifiesto de Pasajeros - Revisión previa (Salida N° @Model.ID_Salida)</span>
        <span class="text-muted small fw-normal">@Model.Pasajeros.Count de @Model.Capacidad asientos ocupados</span>
    </div>
    <div class="ssc-card-body">

        <div class="row mb-4 bg-light p-3 rounded mx-0">
            <div class="col-md-3 border-end">
                <span class="text-muted d-block small">Ruta</span>
                <strong class="fs-6">@Model.Origen - @Model.Destino</strong>
            </div>
            <div class="col-md-3 border-end">
                <span class="text-muted d-block small">Fecha</span>
                <strong class="fs-6">@Model.Fecha.ToString("dd/MM/yyyy")</strong>
            </div>
            <div class="col-md-3 border-end">
                <span class="text-muted d-block small">Hora Salida</span>
                <strong class="fs-6">@Model.Hora.ToString(@"hh\:mm")</strong>
            </div>
            <div class="col-md-3">
                <span class="text-muted d-block small">Vehículo Asignado</span>
                <strong class="fs-6">Placa: @Model.Placa_Vehiculo</strong>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-ssc table-striped table-hover align-middle border">
                <thead>
                    <tr>
                        <th scope="col" class="text-center" style="width: 10%;">N° Asiento</th>
                        <th scope="col" style="width: 30%;">Nombre Completo</th>
                        <th scope="col" style="width: 12%;">Tipo Doc.</th>
                        <th scope="col" style="width: 18%;">N° Documento</th>
                        <th scope="col" style="width: 15%;">Nacionalidad</th>
                        <th scope="col" style="width: 15%;">Género</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Pasajeros.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">
                                <i class="bi bi-info-circle fs-4 d-block mb-2"></i>
                                No hay pasajeros registrados para este viaje en este momento.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var pasajero in Model.Pasajeros)
                        {
                            <tr>
                                <td class="text-center fw-bold text-secondary">@pasajero.NumeroAsiento</td>
                                <td class="fw-medium">@pasajero.Nombre_Completo</td>
                                <td>@pasajero.Tipo_Documento</td>
                                <td>@pasajero.Documento</td>
                                <td>@pasajero.Nacionalidad</td>
                                <td>@pasajero.Genero</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <div class="d-flex justify-content-end mt-4 gap-2">
            <a asp-controller="Manifiesto" asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Volver
            </a>

            <a asp-controller="Manifiesto"
               asp-action="GenerarManifiestoPdf"
               asp-route-idSalida="@Model.ID_Salida"
               target="_blank"
               class="btn btn-ssc px-4">
                <i class="bi bi-printer"></i> Exportar Manifiesto Oficial (PDF horizontal)
            </a>
        </div>

    </div>
</div>
