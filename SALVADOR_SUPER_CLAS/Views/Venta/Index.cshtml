@model List<SalidaResumenDto>
@{
    ViewData["Title"] = "Venta de Pasajes";
}

<partial name="_PasosVenta" model="1" />

@if (!Model.Any())
{
    <div class="ssc-card text-center p-5">
        <i class="bi bi-calendar-x" style="font-size:2.5rem;color:#94A3B8;"></i>
        <h3 class="mt-3" style="font-size:1.2rem;">No hay viajes programados desde hoy</h3>
        <p class="text-muted mb-0">El Administrador debe programar nuevas salidas (HU05).</p>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var s in Model)
        {
            bool esHoy = s.Fecha.Date == DateTime.Today;
            bool lleno = s.Asientos_Libres <= 0;
            int porcentaje = s.Asientos_Totales == 0 ? 0 : s.Asientos_Vendidos * 100 / s.Asientos_Totales;

            <div class="col-md-6 col-xl-4">
                <div class="ssc-card viaje-card">
                    <div class="ssc-card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div class="viaje-ruta">@s.Origen <i class="bi bi-arrow-right" style="color:#548383;"></i> @s.Destino</div>
                            @if (esHoy)
                            {
                                <span class="badge-estado badge-hoy">Hoy</span>
                            }
                            else
                            {
                                <span class="badge-estado badge-proxima">Próximo</span>
                            }
                        </div>

                        <div class="d-flex flex-wrap gap-3 small text-muted mb-3">
                            <span><i class="bi bi-calendar3"></i> @s.Fecha.ToString("dd/MM/yyyy")</span>
                            <span><i class="bi bi-clock"></i> @s.Hora.ToString(@"hh\:mm")</span>
                            <span><i class="bi bi-bus-front"></i> @s.Placa_Vehiculo</span>
                        </div>

                        <div class="d-flex justify-content-between small mb-1">
                            <span>@s.Asientos_Libres asientos libres</span>
                            <span class="text-muted">@s.Asientos_Vendidos/@s.Asientos_Totales vendidos</span>
                        </div>
                        <div class="barra-ocupacion mb-3"><span style="width:@porcentaje%;"></span></div>

                        <div class="d-flex justify-content-between align-items-center">
                            <span class="fw-bold fs-5" style="color:#1E293B;">@ApiHelper.Bs(s.Tarifa)</span>
                            @if (lleno)
                            {
                                <button class="btn btn-secondary" disabled>Agotado</button>
                            }
                            else
                            {
                                <a asp-action="SeleccionarAsiento" asp-route-idSalida="@s.ID_Salida" class="btn btn-ssc">
                                    Elegir viaje <i class="bi bi-arrow-right"></i>
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
