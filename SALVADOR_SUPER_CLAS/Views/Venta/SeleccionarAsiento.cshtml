@model SALVADOR_SUPER_CLAS.Models.Salida

@{
    ViewData["Title"] = "Selección de Asientos";
}

<div class="container mt-4">
    <div class="text-center mb-4">
        <h2>Viaje: @Model.Origen - @Model.Destino</h2>
        <p class="text-muted">Fecha: @Model.Fecha.ToShortDateString() | Tarifa: $@Model.Tarifa</p>

        <div class="d-flex justify-content-center gap-4 mt-3">
            <div><span class="badge" style="background-color: #548383;">&nbsp;&nbsp;</span> Libre</div>
            <div><span class="badge bg-danger">&nbsp;&nbsp;</span> Ocupado</div>
        </div>
    </div>

    <div class="bus-container">
        <div class="bus-grid">
            @*
            *@
            @foreach (var asiento in Model.Asientos.OrderBy(a => a.Numero))
            {
                var estadoClase = asiento.Venta == null ? "asiento-libre" : "asiento-ocupado";

                <div class="asiento @estadoClase" data-id-asiento="@asiento.ID_Asiento">
                    @asiento.Numero
                </div>
            }
        </div>
    </div>
</div>
@section Scripts {
    <script src="~/js/asientos.js"></script>
}