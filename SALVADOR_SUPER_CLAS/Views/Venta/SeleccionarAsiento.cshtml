@model SalidaDetalleDto
@{
    ViewData["Title"] = "Venta de Pasajes";
    int capacidad = Model.Asientos.Count;
    int columnas = (int)Math.Ceiling(capacidad / 4.0);
    int libres = Model.Asientos.Count(a => !a.Vendido);
}

<partial name="_PasosVenta" model="2" />

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <div class="viaje-ruta">@Model.Origen <i class="bi bi-arrow-right" style="color:#548383;"></i> @Model.Destino</div>
        <div class="small text-muted">
            <i class="bi bi-calendar3"></i> @Model.Fecha.ToString("dd/MM/yyyy") &nbsp;
            <i class="bi bi-clock"></i> @Model.Hora.ToString(@"hh\:mm") &nbsp;
            <i class="bi bi-bus-front"></i> @Model.Placa_Vehiculo &nbsp;
            <i class="bi bi-cash"></i> @ApiHelper.Bs(Model.Tarifa)
        </div>
    </div>
    <div class="leyenda">
        <span><span class="muestra" style="background:#548383;"></span>Disponible</span>
        <span><span class="muestra" style="background:#F59E0B;"></span>Seleccionado</span>
        <span><span class="muestra" style="background:#94A3B8;"></span>Vendido</span>
    </div>
</div>

<div class="croquis-layout">
    <div class="bus" id="croquis"
         data-url-estado="@Url.Action("EstadoAsientos", "Venta", new { idSalida = Model.ID_Salida })"
         data-url-formulario="@Url.Action("FormularioVenta", "Venta")">

        <div class="bus-cabina">
            <span class="puerta"><i class="bi bi-door-open"></i> Puerta</span>
            <span class="frente">FRENTE</span>
            <div class="conductor">
                <svg width="40" height="40" viewBox="0 0 40 40" aria-hidden="true">
                    <circle cx="20" cy="20" r="16" fill="none" stroke="#1E293B" stroke-width="3" />
                    <circle cx="20" cy="20" r="4" fill="#1E293B" />
                    <line x1="20" y1="24" x2="20" y2="36" stroke="#1E293B" stroke-width="3" />
                    <line x1="16.5" y1="18" x2="5" y2="15" stroke="#1E293B" stroke-width="3" />
                    <line x1="23.5" y1="18" x2="35" y2="15" stroke="#1E293B" stroke-width="3" />
                </svg>
                <span>Conductor</span>
            </div>
        </div>

        <div class="bus-asientos" style="grid-template-columns: repeat(@columnas, 46px);">
            <div class="pasillo">PASILLO</div>
            @foreach (var asiento in Model.Asientos.OrderBy(a => a.Numero))
            {
                int columna = (asiento.Numero - 1) / 4 + 1;
                int posicion = (asiento.Numero - 1) % 4;
                int fila = posicion < 2 ? posicion + 1 : posicion + 2;
                string clase = asiento.Vendido ? "asiento-ocupado" : "asiento-libre";

                <button type="button" class="asiento @clase"
                        style="grid-column:@columna; grid-row:@fila;"
                        data-id-asiento="@asiento.ID_Asiento" data-numero="@asiento.Numero"
                        title="Asiento @asiento.Numero - @(asiento.Vendido ? "Vendido" : "Disponible")"
                        disabled="@asiento.Vendido">
                    @asiento.Numero
                </button>
            }
        </div>

        <div class="bus-trasera">PARTE TRASERA</div>
    </div>

    <div class="ssc-card panel-seleccion">
        <div class="ssc-card-header"><span><i class="bi bi-hand-index"></i> Tu selección</span></div>
        <div class="ssc-card-body">
            <div class="text-muted small">Asiento seleccionado</div>
            <div class="asiento-grande" id="asientoElegido">—</div>
            <div class="small text-muted mb-3" id="mensajeSeleccion">Haz clic en un asiento verde del croquis.</div>

            <div class="d-flex justify-content-between small mb-1"><span>Tarifa</span><strong>@ApiHelper.Bs(Model.Tarifa)</strong></div>
            <div class="d-flex justify-content-between small mb-3"><span>Asientos libres</span><strong id="contadorLibres">@libres de @capacidad</strong></div>

            <a id="btnContinuar" class="btn btn-ssc w-100 disabled" aria-disabled="true" href="#">
                Continuar a Datos y Pago <i class="bi bi-arrow-right"></i>
            </a>
            <a asp-action="Index" class="btn btn-link w-100 mt-2"><i class="bi bi-arrow-left"></i> Cambiar de viaje</a>

            <div class="small text-muted mt-2" style="font-size:0.75rem;">
                <i class="bi bi-arrow-repeat"></i> El croquis se actualiza solo cada 5 segundos con las ventas de otras ventanillas.
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/asientos.js" asp-append-version="true"></script>
}
