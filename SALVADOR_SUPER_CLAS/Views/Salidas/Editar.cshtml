@model SalidaFormViewModel
@{
    ViewData["Title"] = "Programación de Salidas";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="ssc-card">
            <div class="ssc-card-header">
                <span><i class="bi bi-pencil-square"></i> Editar salida N° @Model.ID_Salida</span>
                <span class="text-muted small fw-normal">@Model.Asientos_Vendidos pasaje(s) vendido(s)</span>
            </div>
            <div class="ssc-card-body">
                <form asp-action="Editar" asp-route-id="@Model.ID_Salida" method="post">
                    <input type="hidden" asp-for="Asientos_Vendidos" />
                    <partial name="_FormularioSalida" model="Model" />

                    @if (Model.Asientos_Vendidos > 0)
                    {
                        <div class="alert alert-warning small mt-3 mb-0">
                            <i class="bi bi-exclamation-triangle"></i> Esta salida ya tiene pasajes vendidos: solo se puede
                            cambiar a un bus con la misma cantidad de asientos.
                        </div>
                    }

                    <div class="d-flex gap-2 justify-content-end mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-ssc"><i class="bi bi-save"></i> Guardar cambios</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
