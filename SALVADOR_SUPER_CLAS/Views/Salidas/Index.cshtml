@model List<SalidaResumenDto>
@{
    ViewData["Title"] = "Programación de Salidas";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <p class="text-muted mb-0">Programación maestra de salidas internacionales (HU05): rutas, fechas, buses y tarifas.</p>
    <a asp-action="Crear" class="btn btn-ssc"><i class="bi bi-plus-circle"></i> Nueva salida</a>
</div>

<div class="ssc-card">
    <div class="table-responsive">
        <table class="table table-ssc table-hover">
            <thead>
                <tr>
                    <th>N°</th>
                    <th>Ruta</th>
                    <th>Fecha</th>
                    <th>Hora</th>
                    <th>Bus</th>
                    <th class="text-end">Tarifa</th>
                    <th style="width:18%;">Ocupación</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="9" class="text-center text-muted py-4">Todavía no hay salidas programadas.</td></tr>
                }
                @foreach (var salida in Model.OrderByDescending(s => s.Fecha.Date >= DateTime.Today).ThenBy(s => s.Fecha).ThenBy(s => s.Hora))
                {
                    int porcentaje = salida.Asientos_Totales == 0 ? 0 : salida.Asientos_Vendidos * 100 / salida.Asientos_Totales;
                    bool pasada = salida.Fecha.Date < DateTime.Today;
                    bool hoy = salida.Fecha.Date == DateTime.Today;
                    <tr class="@(pasada ? "text-muted" : "")">
                        <td>@salida.ID_Salida</td>
                        <td class="fw-semibold">@salida.Origen <i class="bi bi-arrow-right text-muted"></i> @salida.Destino</td>
                        <td>@salida.Fecha.ToString("dd/MM/yyyy")</td>
                        <td>@salida.Hora.ToString(@"hh\:mm")</td>
                        <td>@salida.Placa_Vehiculo</td>
                        <td class="text-end">@ApiHelper.Bs(salida.Tarifa)</td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="barra-ocupacion flex-grow-1"><span style="width:@porcentaje%;"></span></div>
                                <span class="small text-muted">@salida.Asientos_Vendidos/@salida.Asientos_Totales</span>
                            </div>
                        </td>
                        <td>
                            @if (pasada)
                            {
                                <span class="badge-estado badge-pasada">Finalizada</span>
                            }
                            else if (hoy)
                            {
                                <span class="badge-estado badge-hoy">Hoy</span>
                            }
                            else
                            {
                                <span class="badge-estado badge-proxima">Programada</span>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Editar" asp-route-id="@salida.ID_Salida" class="btn btn-sm btn-outline-secondary" title="Editar">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <a asp-controller="Manifiesto" asp-action="RevisionManifiesto" asp-route-idSalida="@salida.ID_Salida" class="btn btn-sm btn-outline-ssc" title="Manifiesto de aduana">
                                <i class="bi bi-file-earmark-text"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
