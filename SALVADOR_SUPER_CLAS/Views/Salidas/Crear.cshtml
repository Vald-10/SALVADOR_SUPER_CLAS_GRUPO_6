@model SalidaFormViewModel
@{
    ViewData["Title"] = "Programación de Salidas";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="ssc-card">
            <div class="ssc-card-header">
                <span><i class="bi bi-plus-circle"></i> Nueva salida (HU05)</span>
            </div>
            <div class="ssc-card-body">
                <form asp-action="Crear" method="post">
                    <partial name="_FormularioSalida" model="Model" />

                    <div class="alert alert-light border small mt-3 mb-4">
                        <i class="bi bi-info-circle"></i> Al guardar, el sistema crea automáticamente todos los asientos
                        del bus elegido como <strong>disponibles</strong> para la venta.
                    </div>

                    <div class="d-flex gap-2 justify-content-end">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-ssc"><i class="bi bi-save"></i> Guardar salida</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
