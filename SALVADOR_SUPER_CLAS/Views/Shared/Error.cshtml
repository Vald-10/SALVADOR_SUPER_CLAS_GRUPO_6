@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="ssc-card text-center p-5 mx-auto" style="max-width:560px;">
    <i class="bi bi-exclamation-octagon" style="font-size:3rem;color:#B42318;"></i>
    <h2 class="mt-3" style="font-size:1.4rem;">Ocurrió un error inesperado</h2>
    <p class="text-muted">No se pudo completar la operación. Verifica que la API (SALVADOR_API) esté ejecutándose e intenta de nuevo.</p>

    @if (Model.ShowRequestId)
    {
        <p class="small text-muted"><strong>Código de solicitud:</strong> <code>@Model.RequestId</code></p>
    }

    <a asp-controller="Home" asp-action="Index" class="btn btn-ssc mt-2"><i class="bi bi-house-door"></i> Volver al inicio</a>
</div>
