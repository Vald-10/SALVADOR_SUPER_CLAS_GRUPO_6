@model CierreCajaDto
@{
    ViewData["Title"] = "Control de Cajas";
}

<div class="d-flex justify-content-between align-items-center mb-3 no-imprimir">
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Volver al control de cajas</a>
    <button type="button" class="btn btn-ssc-navy" onclick="window.print()"><i class="bi bi-printer"></i> Imprimir arqueo</button>
</div>

<partial name="_ResumenCaja" model="Model" />
