@model ReporteDto
@{
    ViewData["Title"] = "Reportes y Estadísticas";

    decimal maximo = Model.Ingresos_Ultimos_Dias.Any() ? Model.Ingresos_Ultimos_Dias.Max(d => d.Total) : 0m;
    decimal escala = 100m;
    while (escala < maximo) { escala = escala * 2 >= maximo ? escala * 2 : escala * 5 >= maximo ? escala * 5 : escala * 10; }
    var diaMaximo = Model.Ingresos_Ultimos_Dias.OrderByDescending(d => d.Total).FirstOrDefault();

    decimal totalPagos = Model.Total_Efectivo + Model.Total_QR;
    int pctEfectivo = totalPagos == 0 ? 0 : (int)Math.Round(Model.Total_Efectivo * 100 / totalPagos);
    int pctQR = totalPagos == 0 ? 0 : 100 - pctEfectivo;
    string[] dias = { "Dom", "Lun", "Mar", "Mié", "Jue", "Vie", "Sáb" };
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <p class="text-muted mb-0">Estadísticas e historial financiero general del sistema.</p>
    <span class="badge-estado badge-cerrada"><i class="bi bi-eye"></i> Modo solo lectura</span>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="ssc-card kpi kpi-destacado">
            <div class="d-flex justify-content-between"><div class="etiqueta">Ingresos totales</div><div class="icono"><i class="bi bi-cash-coin"></i></div></div>
            <div class="valor">@ApiHelper.Bs(Model.Ingresos_Totales)</div>
            <div class="detalle">Todas las ventas registradas</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="ssc-card kpi">
            <div class="d-flex justify-content-between"><div class="etiqueta">Boletos vendidos</div><div class="icono"><i class="bi bi-ticket-perforated"></i></div></div>
            <div class="valor">@Model.Boletos_Vendidos</div>
            <div class="detalle">Pasajes emitidos</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="ssc-card kpi">
            <div class="d-flex justify-content-between"><div class="etiqueta">Salidas programadas</div><div class="icono"><i class="bi bi-signpost-split"></i></div></div>
            <div class="valor">@Model.Salidas_Programadas</div>
            <div class="detalle">Desde hoy en adelante</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="ssc-card kpi">
            <div class="d-flex justify-content-between"><div class="etiqueta">Cajas abiertas</div><div class="icono"><i class="bi bi-safe2"></i></div></div>
            <div class="valor">@Model.Cajas_Abiertas</div>
            <div class="detalle">Boleteros en turno</div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-8">
        <div class="ssc-card h-100">
            <div class="ssc-card-header"><span><i class="bi bi-bar-chart"></i> Ingresos de los últimos 7 días (Bs.)</span></div>
            <div class="ssc-card-body">
                <div class="d-flex">
                    <div class="d-flex flex-column justify-content-between text-end pe-2 small text-muted" style="height:200px; padding-top:4px;">
                        <span>@escala.ToString("N0")</span>
                        <span>@((escala / 2).ToString("N0"))</span>
                        <span>0</span>
                    </div>
                    <div class="flex-grow-1">
                        <div class="grafico-barras" style="background: linear-gradient(to bottom, #E2E8F0 1px, transparent 1px) 0 4px / 100% 50%;">
                            @foreach (var dia in Model.Ingresos_Ultimos_Dias)
                            {
                                decimal alto = escala == 0 ? 0 : dia.Total * 100 / escala;
                                bool etiquetar = dia.Total > 0 && (dia == diaMaximo || dia.Fecha.Date == DateTime.Today);
                                <div class="columna">
                                    <span class="tooltip-barra">@dia.Fecha.ToString("dd/MM") · @ApiHelper.Bs(dia.Total) · @dia.Boletos boleto(s)</span>
                                    @if (etiquetar)
                                    {
                                        <span class="valor-barra">@dia.Total.ToString("N0")</span>
                                    }
                                    <div class="barra" style="height:@(alto.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%;"></div>
                                </div>
                            }
                        </div>
                        <div class="grafico-etiquetas">
                            @foreach (var dia in Model.Ingresos_Ultimos_Dias)
                            {
                                <span>@dias[(int)dia.Fecha.DayOfWeek] @dia.Fecha.Day</span>
                            }
                        </div>
                    </div>
                </div>

                <details class="mt-3 small">
                    <summary class="text-muted">Ver tabla de datos</summary>
                    <table class="table table-sm table-ssc mt-2">
                        <thead><tr><th>Día</th><th class="text-center">Boletos</th><th class="text-end">Ingresos</th></tr></thead>
                        <tbody>
                            @foreach (var dia in Model.Ingresos_Ultimos_Dias)
                            {
                                <tr><td>@dia.Fecha.ToString("dddd dd/MM")</td><td class="text-center">@dia.Boletos</td><td class="text-end">@ApiHelper.Bs(dia.Total)</td></tr>
                            }
                        </tbody>
                    </table>
                </details>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="ssc-card h-100">
            <div class="ssc-card-header"><span><i class="bi bi-wallet2"></i> Ingresos por método de pago</span></div>
            <div class="ssc-card-body">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="kpi p-0"><div class="icono"><i class="bi bi-cash-stack"></i></div></div>
                    <div class="flex-grow-1">
                        <div class="small text-muted">Efectivo</div>
                        <div class="fw-bold fs-5">@ApiHelper.Bs(Model.Total_Efectivo)</div>
                    </div>
                    <div class="fw-semibold text-muted">@pctEfectivo%</div>
                </div>
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="kpi p-0"><div class="icono"><i class="bi bi-qr-code"></i></div></div>
                    <div class="flex-grow-1">
                        <div class="small text-muted">Código QR</div>
                        <div class="fw-bold fs-5">@ApiHelper.Bs(Model.Total_QR)</div>
                    </div>
                    <div class="fw-semibold text-muted">@pctQR%</div>
                </div>
                <p class="small text-muted mb-0">El efectivo debe cuadrar con el arqueo físico de cada caja; el QR se concilia con el banco.</p>
            </div>
        </div>
    </div>
</div>

<div class="ssc-card mb-4">
    <div class="ssc-card-header"><span><i class="bi bi-bus-front"></i> Ocupación de los buses por salida</span></div>
    <div class="table-responsive">
        <table class="table table-ssc align-middle">
            <thead>
                <tr>
                    <th>Ruta</th>
                    <th>Fecha y hora</th>
                    <th>Bus</th>
                    <th style="width:34%;">Ocupación</th>
                    <th class="text-end">Ingresos</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Ocupacion.Any())
                {
                    <tr><td colspan="5" class="text-center text-muted py-4">No hay salidas registradas.</td></tr>
                }
                @foreach (var o in Model.Ocupacion)
                {
                    <tr>
                        <td class="fw-semibold">@o.Ruta</td>
                        <td>@o.Fecha.ToString("dd/MM/yyyy") @o.Hora.ToString(@"hh\:mm")</td>
                        <td>@o.Placa_Vehiculo</td>
                        <td>
                            <div class="d-flex align-items-center gap-2" title="@o.Vendidos de @o.Capacidad asientos vendidos">
                                <div class="pista-horizontal flex-grow-1">
                                    <div class="barra-horizontal" style="width:@o.Porcentaje%;"></div>
                                </div>
                                <span class="small text-muted text-nowrap" style="min-width:90px;">@o.Vendidos/@o.Capacidad (@o.Porcentaje%)</span>
                            </div>
                        </td>
                        <td class="text-end">@ApiHelper.Bs(o.Ingresos)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="ssc-card">
    <div class="ssc-card-header"><span><i class="bi bi-journal-text"></i> Historial financiero: últimas cajas cerradas</span></div>
    <div class="table-responsive">
        <table class="table table-ssc table-hover">
            <thead>
                <tr>
                    <th>Caja</th>
                    <th>Boletero</th>
                    <th>Fecha</th>
                    <th class="text-end">Monto inicial</th>
                    <th class="text-center">Boletos</th>
                    <th class="text-end">Efectivo</th>
                    <th class="text-end">QR</th>
                    <th class="text-end">Monto final</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Historial_Cajas.Any())
                {
                    <tr><td colspan="8" class="text-center text-muted py-4">Todavía no hay cajas cerradas.</td></tr>
                }
                @foreach (var c in Model.Historial_Cajas)
                {
                    <tr>
                        <td>N° @c.ID_Caja</td>
                        <td>@c.NombreCompleto</td>
                        <td>@c.Fecha_Apertura.ToString("dd/MM/yyyy")</td>
                        <td class="text-end">@ApiHelper.Bs(c.Monto_Inicial)</td>
                        <td class="text-center">@c.Cantidad_Boletos</td>
                        <td class="text-end">@ApiHelper.Bs(c.Total_Efectivo)</td>
                        <td class="text-end">@ApiHelper.Bs(c.Total_QR)</td>
                        <td class="text-end fw-bold">@ApiHelper.Bs(c.Monto_Final)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
